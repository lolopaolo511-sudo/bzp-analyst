# BZP Analyst — zmienne środowiskowe
# Skopiuj do .env i uzupełnij wartości

# API BZP — brak klucza wymagany dla odczytu publicznego!
# BZP_API_BASE=https://ezamowienia.gov.pl/mo-board/api/v1

# Powiadomienia (opcjonalne)
BZP_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/HERE
BZP_TELEGRAM_TOKEN=your_telegram_bot_token
BZP_TELEGRAM_CHAT=your_chat_id

# Email (opcjonalne)
BZP_EMAIL_FROM=bzp@yourdomain.pl
BZP_EMAIL_TO=you@yourdomain.pl
BZP_SMTP_HOST=smtp.gmail.com
BZP_SMTP_PORT=587
BZP_SMTP_USER=
BZP_SMTP_PASS=

# Make.com webhook (opcjonalne)
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/YOUR_WEBHOOK

# Ollama (jeśli inny host)
OLLAMA_BASE_URL=http://localhost:11434
